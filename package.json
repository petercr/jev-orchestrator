{
  "name": "jev-orchestrator",
  "version": "0.2.0",
  "description": "A small Jev-steered coding-agent orchestrator experiment.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "jev-agent": "./dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "node --import tsx src/cli.ts",
    "dev:env": "varlock run --inject vars -- node --import tsx src/cli.ts",
    "env:check": "varlock load --agent",
    "env:check:schema": "varlock load --agent --path .env.schema",
    "env:run": "varlock run --inject vars --",
    "prepack": "pnpm build",
    "start": "node dist/cli.js",
    "start:env": "varlock run --inject vars -- node dist/cli.js",
    "test": "vitest run",
    "verify:jev": "node scripts/verify-jev.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ai": "7.0.106"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "varlock": "1.22.0",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@11.19.0"
}
