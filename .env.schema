# Shared Varlock schema. Commit this file; keep credential values in ignored
# .env/.env.local files or supply them through the process environment.
# Credentials are optional here so mock runs and CI stay keyless. The CLI
# requires a credential for the selected provider before any live request.
# @defaultRequired=false @defaultSensitive=false
# @redact=true
# ---

# Select the live decision transport. Unset selectors default to direct TypeSafe.
# @type=enum(typesafe, openrouter, vercel, cloudflare)
ROUTER_PROVIDER=

# Compatibility selector. If both selectors are set, they must agree.
# Keep both defaults absent so either selector can be supplied independently.
# @type=enum(typesafe, openrouter, vercel, cloudflare)
JEV_PROVIDER=

# Vercel AI Gateway credential.
# @sensitive @docs(https://vercel.com/ai-gateway)
AI_GATEWAY_API_KEY=

# OpenRouter credential. A nonblank canonical key takes precedence over its alias.
# @sensitive @docs(https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=

# Compatibility alias for OPENROUTER_API_KEY.
# @sensitive
OPENROUTE_API_KEY=

# Direct TypeSafe credential. A nonblank canonical key takes precedence over its alias.
# @sensitive @docs(https://typesafe.ai)
TYPESAFE_API_KEY=

# Compatibility alias for TYPESAFE_API_KEY.
# @sensitive
TYPESAFE_AI_API_KEY=

# Cloudflare Workers AI account identifier (required only for cloudflare).
# @sensitive @type=string(matches=regex("^[a-fA-F0-9]{32}$"))
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare token scoped to this account with Workers AI Read and Edit.
# @sensitive @docs(https://developers.cloudflare.com/workers-ai/get-started/rest-api/)
CLOUDFLARE_AUTH_TOKEN=

# Optional model in the selected provider's namespace; blank uses its default.
# vercel: typesafe-ai/jev | openrouter: typesafe/jev-1.13 | typesafe: jev-latest
# Direct pinned TypeSafe version: jev-1.13.0
# cloudflare: clef (default) or clef-flash
# @type=string(maxLength=256)
ROUTER_MODEL=

# OpenRouter-only fallback when ROUTER_MODEL is blank.
# @type=string(maxLength=256)
OPENROUTE_MODEL=
