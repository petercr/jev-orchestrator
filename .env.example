# Select typesafe (default), vercel, or openrouter. Only that provider needs a key.
JEV_PROVIDER=typesafe
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Accepted alias: OPENROUTE_API_KEY. OPENROUTE_MODEL is an OpenRouter-only
# model fallback when ROUTER_MODEL is blank.
# https://typesafe.ai — create a key in your TypeSafe account
TYPESAFE_API_KEY=
# Accepted alias: TYPESAFE_AI_API_KEY.
# Optional override in the selected provider's namespace; blank uses its default.
# vercel: typesafe-ai/jev | openrouter: typesafe/jev-1.13 | typesafe: jev-latest
# Direct pinned TypeSafe version: jev-1.13.0
ROUTER_MODEL=
