# Copy to .env or .env.local for local values. .env.schema owns Varlock validation.
# Use pnpm env:check for redacted diagnostics and pnpm dev:env to load values.
# Select typesafe (default), vercel, openrouter, or cloudflare. Only that provider needs a key.
ROUTER_PROVIDER=typesafe
# Compatibility selector; omit it or keep it equal to ROUTER_PROVIDER.
# JEV_PROVIDER=typesafe
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Accepted alias for OPENROUTER_API_KEY.
OPENROUTE_API_KEY=
# https://typesafe.ai — create a key in your TypeSafe account
TYPESAFE_API_KEY=
# Accepted alias for TYPESAFE_API_KEY.
TYPESAFE_AI_API_KEY=
# Cloudflare account ID (32 hex characters); required only for cloudflare.
CLOUDFLARE_ACCOUNT_ID=
# Account-scoped token with Workers AI Read and Edit permissions.
CLOUDFLARE_AUTH_TOKEN=
# Optional override in the selected provider's namespace; blank uses its default.
# vercel: typesafe-ai/jev | openrouter: typesafe/jev-1.13 | typesafe: jev-latest
# Direct pinned TypeSafe version: jev-1.13.0
# cloudflare: clef (default) or clef-flash
ROUTER_MODEL=
# OpenRouter-only model fallback when ROUTER_MODEL is blank.
OPENROUTE_MODEL=
